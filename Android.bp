cc_prebuilt_library_shared {
    name: "libaualgo_foundation",
    owner: "motorola",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/vendor/lib/libaualgo_foundation.so"],
        },
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/libaualgo_foundation.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

